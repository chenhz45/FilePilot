<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FilePilot.App.App"
             xmlns:local="using:FilePilot.App"
             RequestedThemeVariant="Light">
             <!-- Force Light theme: app UI hardcodes light backgrounds; Dark would render white-on-gray text -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>